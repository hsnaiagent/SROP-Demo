{
  "name": "srop-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "demo:backup": "next dev -p 3001",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "data": "python scripts/generate_data.py && python scripts/check_data.py",
    "probe:auth": "node scripts/probe-1-auth.mjs",
    "probe:execute": "node scripts/probe-2-execute.mjs",
    "probe": "npm run probe:auth && npm run probe:execute",
    "test:plan": "node --experimental-strip-types --import ./scripts/ts-resolve.mjs --test scripts/plan.test.mjs",
    "test:rules": "node --experimental-strip-types --import ./scripts/ts-resolve.mjs --test scripts/rules.test.mjs",
    "test": "node --experimental-strip-types --import ./scripts/ts-resolve.mjs --test scripts/*.test.mjs",
    "smoke": "node scripts/smoke.mjs",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
